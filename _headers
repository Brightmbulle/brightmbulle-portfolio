# Response headers for Cloudflare Workers static assets.
# A path pattern, then indented "Name: value" lines.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fonts never change: cache for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons: cache for 30 days.
/favicon.ico
  Cache-Control: public, max-age=2592000
/assets/icons/*
  Cache-Control: public, max-age=2592000

# Images and the CV keep their file names when replaced, so cache for 30 days
# with a background refresh, instead of forever.
/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/pdf/*
  Cache-Control: public, max-age=604800

# CSS and JS are linked with ?v=... version tags in index.html: bump the tag
# after editing a file and browsers fetch the new copy immediately.
/assets/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
