// Cloudflare Pages config for the portfolio.
// Live at https://brightmbulle.pages.dev
// Deploy with: npm run deploy  (builds dist/ and uploads it)
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "brightmbulle",
    "compatibility_date": "2026-11-24",
    // Built by scripts/build.mjs: only the files the site needs.
    // Pages serves 404.html for unknown URLs and applies _headers automatically.
    "pages_build_output_dir": "./dist"
}
