# Files Wrangler must NOT upload to Cloudflare (same syntax as .gitignore).
# Everything else in the repo root is served publicly.

# Repo, tooling and config
.git
.github
.claude
.wrangler
node_modules
.gitignore
.assetsignore
wrangler.jsonc
package.json
package-lock.json
README.md

# Original design files and full-size images. The site only loads the
# optimized .webp versions; keep the originals in the repo, not online.
assets/img/*.svg
assets/img/*.png
assets/img/*.jpg
assets/img/*.JPG
# ...except the PNG fallback for the hero portrait (browsers without WebP)
!assets/img/profile-cutout.png
